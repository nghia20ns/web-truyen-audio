<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= truyen.name %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
    
    <style>
        /* --- RESET & GLOBAL COMPACT STYLES --- */
        body { 
            font-family: 'Quicksand', sans-serif; 
            background: #fff; 
            color: #333;
            margin: 0; padding: 0;
            padding-bottom: 60px;
        }
        
        .compact-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 15px;
        }

        /* --- 1. HERO SECTION --- */
        .hero-wrap {
            display: flex;
            gap: 15px;
            margin-bottom: 15px;
        }
        .hero-img {
            width: 90px;
            flex-shrink: 0;
            border-radius: 6px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            aspect-ratio: 2/3;
            object-fit: cover;
        }
        .hero-info { flex-grow: 1; }
        .hero-title {
            font-size: 1.1rem;
            font-weight: 700;
            line-height: 1.3;
            margin: 0 0 6px 0;
            color: #111;
        }
        .meta-text {
            font-size: 0.85rem;
            color: #666;
            margin-bottom: 6px;
        }
        .tag-row { display: flex; flex-wrap: wrap; gap: 5px; }
        .tiny-tag {
            background: #f3f4f6;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 0.75rem;
            color: #555;
            font-weight: 600;
        }

        /* --- 2. DESCRIPTION (Cập nhật logic từng đoạn) --- */
        .desc-box {
            background: #f9fafb;
            padding: 12px 14px;
            border-radius: 8px;
            font-size: 0.95rem; /* Chữ to rõ hơn xíu */
            color: #444;
            line-height: 1.6;
            margin-bottom: 20px;
            text-align: justify;
        }
        .desc-content {
            display: -webkit-box;
            -webkit-line-clamp: 8; /* [QUAN TRỌNG] Mặc định hiện 8 dòng */
            -webkit-box-orient: vertical;
            overflow: hidden;
            transition: max-height 0.3s ease;
        }
        /* Class này dùng khi đã hiện hết */
        .desc-content.full-show { 
            -webkit-line-clamp: unset !important; 
            display: block;
        }
        
        .toggle-desc {
            color: #6366f1; font-weight: 700; font-size: 0.85rem;
            cursor: pointer; margin-top: 8px; display: inline-block;
            user-select: none;
        }

        /* --- 3. CHAPTER LIST --- */
        .section-title {
            font-size: 0.95rem; font-weight: 700; color: #111;
            margin-bottom: 10px;
            border-left: 3px solid #6366f1; padding-left: 8px;
            display: flex; justify-content: space-between; align-items: center;
        }

        .chapter-grid-compact {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); 
            gap: 8px;
        }

        .chapter-btn {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 6px;
            padding: 8px 5px;
            text-align: center;
            text-decoration: none;
            transition: all 0.1s;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 50px;
        }

        .chapter-btn:hover {
            border-color: #6366f1;
            background: #eef2ff;
        }
        
        .cp-num {
            font-size: 0.85rem; font-weight: 600; color: #333;
            margin-bottom: 2px;
        }
        .cp-price {
            font-size: 0.75rem; color: #d97706; font-weight: 700;
        }

        .nav-back {
            display: inline-flex; align-items: center; gap: 5px;
            color: #666; font-size: 0.9rem; font-weight: 600;
            text-decoration: none; margin-bottom: 15px;
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <div class="compact-container">
        <a href="/" class="nav-back">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
            Trang chủ
        </a>

        <div class="hero-wrap">
            <% 
                let imgUrl = truyen.image || '/images/default-cover.png'; 
                if(imgUrl.includes('cloudinary')) {
                    const uploadIndex = imgUrl.indexOf('/upload/');
                    if(uploadIndex !== -1) {
                        imgUrl = imgUrl.slice(0, uploadIndex + 8) + 'w_150,q_auto,f_auto/' + imgUrl.slice(uploadIndex + 8);
                    }
                }
            %>
            <img src="<%= imgUrl %>" class="hero-img" alt="Cover">
            
            <div class="hero-info">
                <h1 class="hero-title"><%= truyen.name %></h1>
                <div class="meta-text">
                    Số tập: <%= truyen.totalChapters %> • Audio
                </div>
                <div class="tag-row">
                    <% if(truyen.categories && truyen.categories.length > 0) { %>
                        <% truyen.categories.forEach(cat => { %>
                           <span class="tiny-tag"><%= cat.name %></span>
                        <% }) %>
                   <% } else { %>
                        <span class="tiny-tag">Truyện mới</span>
                   <% } %>
                </div>
            </div>
        </div>

        <div class="desc-box">
            <div class="desc-content" id="descText">
                <%- truyen.introduction ? truyen.introduction.replace(/\n/g, '<br>') : "Đang cập nhật..." %>
            </div>
            <div class="toggle-desc" id="toggleDesc" onclick="toggleDescription()">Xem thêm v</div>
        </div>

        <div class="section-title">
            <span>Danh sách tập</span>
            <span style="font-weight:400; font-size:0.8rem; color:#888"><%= parts.length %> gói</span>
        </div>

        <div class="chapter-grid-compact">
            <% parts.forEach(function(part) { %>
                <a href="/payment?truyenId=<%= truyen._id %>&partCode=<%= part.code %>" class="chapter-btn">
                    <span class="cp-num"><%= part.name.replace('Tập ', '') %></span>
                    <span class="cp-price"><%= part.priceText %>đ</span>
                </a>
            <% }); %>
        </div>

        <% if(parts.length === 0) { %>
            <div style="text-align:center; padding:30px; color:#999; font-size:0.9rem;">
                Chưa có tập nào.
            </div>
        <% } %>
    </div>

    <%- include('partials/footer') %>

    <script>
        // --- LOGIC XEM THÊM TỪNG ĐOẠN (LẦN LẦN) ---
        let currentLines = 8; // Mặc định ban đầu
        const step = 10;       // Mỗi lần bấm hiện thêm 8 dòng

        function toggleDescription() {
            const content = document.getElementById('descText');
            const btn = document.getElementById('toggleDesc');
            
            // Nếu đang trạng thái "Thu gọn" -> Reset về ban đầu
            if (btn.innerText.includes('Thu gọn')) {
                currentLines = 8;
                content.style.webkitLineClamp = currentLines;
                content.classList.remove('full-show');
                btn.innerText = 'Xem thêm v';
                // Cuộn nhẹ lên lại phần giới thiệu nếu nó quá dài
                content.scrollIntoView({ behavior: "smooth", block: "center" });
                return;
            }

            // Tăng số dòng hiển thị
            currentLines += step;
            content.style.webkitLineClamp = currentLines;

            // Kiểm tra xem đã hiện hết nội dung chưa
            // (So sánh chiều cao nội dung thực vs chiều cao đang hiển thị)
            if (content.scrollHeight <= content.clientHeight) {
                // Đã hiện hết -> Đổi nút thành Thu gọn
                content.classList.add('full-show'); // Class này bỏ luôn clamp để chắc chắn
                btn.innerText = 'Thu gọn ^';
            }
        }

        // Tự động ẩn nút "Xem thêm" nếu văn bản ngắn hơn 8 dòng từ đầu
        window.addEventListener('load', () => {
            const content = document.getElementById('descText');
            const btn = document.getElementById('toggleDesc');
            if (content.scrollHeight <= content.clientHeight) {
                btn.style.display = 'none';
            }
        });
    </script>
</body>
</html>