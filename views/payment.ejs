<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thanh Toán - PayOS</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/images/logo.png" type="image/x-icon">
    <style>
        /* Giữ nguyên CSS cũ */
        .info-box {
            background-color: #f8f9fa;
            border: 1px dashed #ced4da;
            padding: 10px;
            border-radius: 6px;
            margin-top: 15px;
            font-family: monospace;
            color: #333;
            word-break: break-all;
        }
        .guide-box {
            margin-top: 20px;
            padding: 15px;
            background-color: #e3f2fd;
            border-radius: 8px;
            text-align: left;
            font-size: 0.9rem;
            color: #0d47a1;
            border-left: 4px solid #2196f3;
        }
        .guide-box ul { padding-left: 20px; margin: 5px 0 0 0; }
        .guide-box li { margin-bottom: 6px; }

        #email-alert {
            background-color: #fff3cd; 
            color: #856404;           
            border: 2px solid #ffeeba; 
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 8px;
            font-size: 1.1rem;        
            font-weight: bold;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1); 
            animation: popIn 0.5s ease; 
        }
        @keyframes popIn {
            0% { transform: scale(0.8); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        
        /* Loading Spinner cho nút bấm */
        .spinner {
            border: 3px solid #f3f3f3;
            border-radius: 50%;
            border-top: 3px solid #3498db;
            width: 16px;
            height: 16px;
            -webkit-animation: spin 2s linear infinite; /* Safari */
            animation: spin 2s linear infinite;
            display: inline-block;
            margin-right: 5px;
            vertical-align: middle;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
<%- include('partials/header') %>
    <div class="container" style="max-width: 500px;">
        <a href="javascript:history.back()" class="nav-btn" style="padding-left: 0; margin-bottom: 10px;">
            ⬅ Quay lại chọn tập
        </a>

        <div class="card">

            <div style="text-align: center; margin-bottom: 20px;">
                <h3 style="margin: 0; color: var(--primary);">Xác nhận mua</h3>
                <h5 style="margin: 0; color: var(--danger);">💳 <strong>Nhắn nhỏ:</strong> Nếu anh em muốn mua bằng thẻ cào thì nhắn em Cat qua Zalo hoặc Discord nhé!!!</h5>

                <p style="color: var(--text-sub);">Truyện: <strong><%= truyenName %></strong></p>
                <div class="badge" style="background: var(--secondary); color: white; display: inline-block;">
                    Tập <%= partCode %>
                </div>
                <div style="font-size: 1.5rem; font-weight: bold; color: #10b981; margin-top: 10px;">
                    <%= amountText %>đ
                </div>
            </div>

            <div id="input-section">
                <label>Email (Vui lòng điền đúng gmail):</label>
                <input type="text" id="gmail" placeholder="Ví dụ: quocnghia1123@gmail.com" required>
                
                <div style="margin: 15px 0; font-size: 0.9em; color: #555;">
                    <p>💡 Sau khi bấm nút, bạn sẽ được chuyển đến trang thanh toán của PayOS (MB Bank, VietQR).</p>
                </div>

                <button id="pay-btn" class="btn-primary" onclick="createPayment()">
                    Thanh toán ngay
                </button>
            </div>
            
            <div class="guide-box" style="margin-top: 30px;">
                <strong>🔔 Lưu ý quan trọng:</strong>
                <ul>
                    <li>Hệ thống sẽ tự động gửi quyền truy cập sau khi thanh toán thành công.</li>
                    <li>Vui lòng kiểm tra kỹ trong <strong>thư rác, spam</strong>.</li>
                    <li>Trong vòng 3-5h nếu không thấy thì hãy nhắn tin qua zalo hoặc discord.</li>
                    <li>Đăng nhập Drive bằng <strong>đúng Gmail</strong> bạn đã điền ở trên để nghe.</li>
                </ul>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        async function createPayment() {
            // 1. Lấy giá trị và chuẩn hóa
            const rawInput = document.getElementById('gmail').value.trim();
            const btn = document.getElementById('pay-btn');
            
            // Các biến từ server EJS
            const shortCode = "<%= shortCode %>"; 
            const tapText = "<%= tapText %>"; 
            const amount = "<%= amount %>"; 

            // 2. VALIDATION (Giữ nguyên logic của bạn)
            const strictGmailRegex = /^[a-zA-Z0-9]+@gmail\.com$/;

            if (!rawInput) {
                alert("Vui lòng nhập địa chỉ Gmail!");
                return;
            }

            if (!rawInput.endsWith("@gmail.com")) {
                alert("Lỗi: Email bắt buộc phải có đuôi @gmail.com");
                return;
            }

            if (!strictGmailRegex.test(rawInput)) {
                alert("Lỗi: Gmail không được chứa dấu chấm (.), khoảng trắng hoặc ký tự đặc biệt trong phần tên.");
                return;
            }

            // --- BẮT ĐẦU GỌI API PAYOS ---
            
            // Khóa nút để tránh bấm nhiều lần
            const originalText = btn.innerText;
            btn.innerHTML = '<span class="spinner"></span> Đang tạo đơn...';
            btn.disabled = true;

            try {
                // Gọi về Backend (Node.js)
                const response = await fetch('/create-payment-link', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        email: rawInput,
                        amount: amount,   // Gửi số tiền (dạng số hoặc chuỗi đều được, backend sẽ parse)
                        storyCode: shortCode,
                        tapText: tapText,
                        returnUrl: window.location.href // <--- THÊM DÒNG NÀY (Gửi link trang hiện tại)
                    })
                });

                const data = await response.json();

                if (data.checkoutUrl) {
                    // Nếu thành công, chuyển hướng sang trang thanh toán
                    window.location.href = data.checkoutUrl;
                } else {
                    // Nếu backend trả về lỗi
                    alert("Có lỗi xảy ra: " + (data.error || "Không xác định"));
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }

            } catch (error) {
                console.error('Error:', error);
                alert("Lỗi kết nối đến server. Vui lòng thử lại sau.");
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
            window.onload = function() {
                const urlParams = new URLSearchParams(window.location.search);
                const status = urlParams.get('status');
                const orderCode = urlParams.get('orderCode');

                if (status === 'PAID') {
                    alert("✅ Thanh toán thành công! Mã đơn: " + orderCode + "\nHệ thống đang xử lý, vui lòng check mail sau ít phút.");
                    // Có thể chuyển hướng về trang chủ nếu muốn: window.location.href = '/';
                } else if (status === 'CANCELLED') {
                    alert("❌ Bạn đã hủy thanh toán.");
                }
            }
        }
    </script>
</body>
</html>