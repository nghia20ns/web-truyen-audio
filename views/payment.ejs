<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thanh Toán</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/images/logo.png" type="image/x-icon">
    <style>
        .info-box {
            background-color: #f8f9fa;
            border: 1px dashed #ced4da;
            padding: 10px;
            border-radius: 6px;
            margin-top: 15px;
            font-family: monospace;
            color: #333;
            word-break: break-all;
        }
        .guide-box {
            margin-top: 20px;
            padding: 15px;
            background-color: #e3f2fd;
            border-radius: 8px;
            text-align: left;
            font-size: 0.9rem;
            color: #0d47a1;
            border-left: 4px solid #2196f3;
        }
        .guide-box ul { padding-left: 20px; margin: 5px 0 0 0; }
        .guide-box li { margin-bottom: 6px; }

        /* --- STYLE MỚI CHO THÔNG BÁO NỔI BẬT --- */
        #email-alert {
            background-color: #fff3cd; /* Nền vàng nhạt */
            color: #856404;           /* Chữ nâu đậm */
            border: 2px solid #ffeeba; /* Viền vàng đậm */
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 8px;
            font-size: 1.1rem;        /* Chữ to hơn bình thường */
            font-weight: bold;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1); /* Đổ bóng cho nổi */
            animation: popIn 0.5s ease; /* Hiệu ứng hiện ra */
        }
        @keyframes popIn {
            0% { transform: scale(0.8); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="nav-content">
            <a href="/" class="logo">🎧 AudioHay</a>
            <div class="nav-links">
                <a href="/" class="nav-btn">🏠 Trang chủ</a>
            </div>
        </div>
    </nav>

    <div class="container" style="max-width: 500px;">
        <a href="javascript:history.back()" class="nav-btn" style="padding-left: 0; margin-bottom: 10px;">
            ⬅ Quay lại chọn tập
        </a>

        <div class="card">
            <div style="text-align: center; margin-bottom: 20px;">
                <h3 style="margin: 0; color: var(--primary);">Xác nhận mua</h3>
                <p style="color: var(--text-sub);">Truyện: <strong><%= truyenName %></strong></p>
                <div class="badge" style="background: var(--secondary); color: white; display: inline-block;">
                    Tập <%= partCode %>
                </div>
                <div style="font-size: 1.5rem; font-weight: bold; color: #10b981; margin-top: 10px;">
                    <%= amountText %>đ
                </div>
            </div>

            <div id="input-section">
                <label>Email (Vui lòng điền đúng gmail):</label>
                <input type="text" id="gmail" placeholder="Ví dụ: quocnghia1123" required>
                <button class="btn-primary" onclick="generateQR()">Tạo mã QR</button>
            </div>

            <div id="qr-container" style="display: none; text-align: center;">
                
                <div id="email-alert">
                    </div>
                <img id="qr-img" src="" alt="QR Code" style="max-width: 100%; border-radius: 8px; border: 1px solid #eee;">
                
                <p style="font-size: 0.9rem; color: var(--text-sub); margin-top: 10px;">
                    Quét mã trên bằng App Ngân hàng.
                </p>

                <div class="info-box">
                    <strong>Nội dung CK:</strong><br>
                    <span id="ck-content-display" style="font-weight: bold; color: #d32f2f;"></span>
                </div>

                <div class="guide-box">
                    <strong>🔔 Hướng dẫn:</strong>
                    <ul>
                        <li>Vui lòng kiểm tra kỹ trong <strong>thư rác, spam</strong>. Trong vòng 3-5h nếu không thấy thì hãy nhắn tin qua zalo hoặc discord đễ được hỗ trợ sớm nhất</li>
                        <li><strong>Lưu ý:</strong> Việc thêm vào nhóm Drive thực hiện thủ công, Admin không online thường xuyên nên có thể sẽ có độ trễ. Mong bạn thông cảm chờ đợi.</li>
                        <li>Đăng nhập Drive bằng <strong>đúng Gmail</strong> bạn đã điền ở trên để nghe.</li>
                        <li>Nếu file nghe không có tốc độ <strong>x1.5, x2</strong>, hãy <strong>cập nhật ứng dụng Google Drive</strong> lên phiên bản mới nhất.</li>
                        <li>Còn nếu vẫn không nghe được <strong>x1.5, x2</strong>, nữa thì hãy <strong>Tải mp3 </strong>về nghe nhé anh em.</li>
                        <li>Mọi sai sót hoặc thắc mắc vui lòng liên hệ Admin qua <strong>Zalo</strong> hoặc <strong>Discord</strong>.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        function generateQR() {
            const rawInput = document.getElementById('gmail').value.trim();
            const shortCode = "<%= shortCode %>"; 
            const tapText = "<%= tapText %>"; 
            const amount = "<%= amount %>"; 

            if (!rawInput) {
                alert("Vui lòng nhập tên Gmail!");
                return;
            }

            // 1. Lấy tên user (bỏ @gmail.com) để làm nội dung CK
            let username = rawInput.split('@')[0];

            // 2. Xử lý hiển thị Full Email cho thông báo
            // Nếu khách nhập "nghia" -> Tự thêm @gmail.com để hiện trong thông báo cho đẹp
            let displayEmail = rawInput;
            if (!displayEmail.includes('@')) {
                displayEmail += '@gmail.com';
            }

            // --- CẬP NHẬT THÔNG BÁO NỔI BẬT ---
            const alertBox = document.getElementById('email-alert');
            // Dùng innerHTML để tô màu đỏ cho email
            alertBox.innerHTML = `⚠️ Sau khi chuyển khoản trong vòng 3-5h không thấy thông báo từ gmail, Vui lòng kiểm tra hộp thư gmail <span style="color: #d32f2f; font-size: 1.2rem; text-decoration: underline;">${displayEmail}</span> để nhận truyện`;

            // 3. Hàm xóa dấu tiếng Việt
            function removeAccents(str) {
                return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "")
                          .replace(/đ/g, "d").replace(/Đ/g, "D");
            }

            const cleanUser = removeAccents(username);
            const cleanCode = removeAccents(shortCode);

            // 4. Tạo nội dung CK (dùng xxx như bạn yêu cầu)
            const content = `- ${cleanUser} - ${cleanCode} - ${tapText} -`;
            
            document.getElementById('ck-content-display').innerText = content;

            const BANK_ID = "MB"; 
            const ACCOUNT_NO = "017120299999";
            const TEMPLATE = "compact2";
            
            const description = encodeURIComponent(content);
            const qrUrl = `https://img.vietqr.io/image/${BANK_ID}-${ACCOUNT_NO}-${TEMPLATE}.png?amount=${amount}&addInfo=${description}`;

            const img = document.getElementById('qr-img');
            img.src = qrUrl;
            
            document.getElementById('input-section').style.display = 'none';
            document.getElementById('qr-container').style.display = 'block';
        }
    </script>
</body>
</html>