<!DOCTYPE html>
<html>
<head>
    <title>Đăng nhập Admin</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body style="display:flex; justify-content:center; align-items:center; height:100vh; background:#f1f5f9;">
    
    <div class="card" style="width: 350px; padding: 30px;">
        <h2 style="text-align: center; color: #333;">🔐 Admin Panel</h2>
        
        <% if (error) { %>
            <div style="background: #fee2e2; color: #dc2626; padding: 10px; border-radius: 5px; margin-bottom: 15px; text-align: center;">
                <%= error %>
            </div>
        <% } %>

        <form action="/login" method="POST">
            <div style="margin-bottom: 15px;">
                <label>Tài khoản:</label>
                <input type="text" name="username" required placeholder="Nhập username..." style="width:100%; padding:10px; margin-top:5px; box-sizing:border-box;">
            </div>
            
            <div style="margin-bottom: 20px;">
                <label>Mật khẩu:</label>
                <input type="password" name="password" required placeholder="Nhập password..." style="width:100%; padding:10px; margin-top:5px; box-sizing:border-box;">
            </div>
            
            <button type="submit" class="btn-primary" style="width: 100%;">Đăng Nhập</button>
        </form>
    </div>

</body>
</html>