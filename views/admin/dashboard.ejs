<!DOCTYPE html>
<html lang="vi">
<head>
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/images/logo.png" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    
    <div class="admin-wrapper">
        <nav class="admin-sidebar">
            <div class="sidebar-brand">
                🎧 Admin Panel
            </div>
            
            <ul class="sidebar-menu">
                <li class="menu-label">Chức năng chính</li>
                <li>
                    <a href="/admin" class="active">
                        🏠 Tổng quan
                    </a>
                </li>
                <li>
                    <a href="/admin/add">
                        ➕ Thêm Truyện Mới
                    </a>
                </li>
                <li>
                    <a href="/chat/manager">
                        💬 Quản Lý Chat
                    </a>
                </li>
                
                <li class="menu-label">Hệ thống</li>
                <li>
                    <a href="/admin/alert">
                        📢 Cấu Hình Thông Báo
                    </a>
                </li>
                <li>
                    <a href="/" target="_blank">
                        🌏 Xem Trang Web
                    </a>
                </li>
                
                <li style="margin-top: 20px; border-top: 1px solid #334155;"></li>
                <li>
                    <a href="/logout" class="logout-link">
                        🚪 Đăng xuất
                    </a>
                </li>
            </ul>
        </nav>

        <main class="admin-content">
            <div class="content-header">
                <h2>Danh sách truyện hiện có</h2>
                <div class="stat-badge">Tổng: <%= listTruyen.length %> truyện</div>
            </div>

            <div class="story-list-container">
                <% if (listTruyen.length === 0) { %>
                    <div class="empty-state">
                        <p>Chưa có truyện nào trong hệ thống.</p>
                        <a href="/admin/add" class="btn-primary" style="display:inline-block; width:auto;">Thêm ngay</a>
                    </div>
                <% } %>

                <% listTruyen.forEach(function(truyen) { %>
                    <div class="admin-story-card">
                        <div class="story-info">
                            <div class="story-name"><%= truyen.name %></div>
                            <div class="story-meta">
                                <span>⚡ <%= truyen.totalChapters %> tập</span>
                                <span>💰 <%= (truyen.price || 1000).toLocaleString('vi-VN') %>đ</span>
                            </div>
                        </div>
                        <div class="story-actions">
                            <a href="/admin/edit/<%= truyen._id %>" class="btn-edit">✏️ Sửa</a>
                        </div>
                    </div>
                <% }); %>
            </div>
        </main>
    </div>

</body>
</html>