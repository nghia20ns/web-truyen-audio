<!DOCTYPE html>
<html lang="vi">
<head>
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/images/logo.png" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    
    <div class="admin-wrapper">
<%- include('../partials/admin-sidebar') %>

<main class="admin-content">
            <div class="content-header">
                <h2>Danh sách truyện hiện có</h2>
                <div class="stat-badge">Tổng: <%= listTruyen.length %> truyện</div>
            </div>

            <div class="story-list-container">
                <% if (listTruyen.length === 0) { %>
                    <div class="empty-state">
                        <p>Chưa có truyện nào trong hệ thống.</p>
                        <a href="/admin/add" class="btn-primary" style="display:inline-block; width:auto;">Thêm ngay</a>
                    </div>
                <% } %>

                <% listTruyen.forEach(function(truyen) { %>
                    <div class="admin-story-card">
                        <div class="story-info">
                            <div class="story-name"><%= truyen.name %></div>
                            <div class="story-meta">
                                <span>⚡ <%= truyen.totalChapters %> tập</span>
                                <span>💰 <%= (truyen.price || 1000).toLocaleString('vi-VN') %>đ</span>
                            </div>
                        </div>
                        <div class="story-actions" style="display: flex; align-items: center; gap: 15px;">
                            <a href="/admin/edit/<%= truyen._id %>" class="btn-edit">✏️ Sửa</a>
                            
                            <label style="cursor: pointer; display: flex; align-items: center; gap: 5px; color: #ef4444; font-weight: bold; font-size: 0.95rem; background: #fef2f2; padding: 5px 10px; border-radius: 8px; border: 1px solid #fecaca;">
                                <input type="checkbox" 
                                       onchange="toggleHot('<%= truyen._id %>', this.checked)" 
                                       <%= truyen.isHot ? 'checked' : '' %> 
                                       style="width: 18px; height: 18px; cursor: pointer; margin: 0;">
                                🔥 Hot
                            </label>
                        </div>
                    </div>
                <% }); %>
            </div>
        </main>
    </div>

</body>
<script>
        // Hàm tự động gọi API khi bạn tick/bỏ tick
        async function toggleHot(id, isHot) {
            try {
                const res = await fetch(`/admin/toggle-hot/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ isHot })
                });
                const data = await res.json();
                
                if(!data.success) {
                    alert("Lỗi: Không thể cập nhật trạng thái Hot!");
                    // Load lại trang nếu lỗi để reset ô tick
                    window.location.reload(); 
                }
            } catch(err) {
                alert("Lỗi kết nối đến máy chủ!");
                window.location.reload();
            }
        }
    </script>
</html>