<!DOCTYPE html>
<html>
<head>
    <title><%= truyen && truyen._id ? 'Sửa Truyện' : 'Thêm Truyện' %></title>
    <link rel="stylesheet" href="/css/style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <div class="admin-wrapper">
        <%- include('../partials/admin-sidebar') %>

        <main class="admin-content">
            <div class="content-header">
                <h2><%= truyen && truyen._id ? 'Chỉnh Sửa Truyện' : 'Thêm Truyện Mới' %></h2>
            </div>

            <% if (error) { %>
                <div style="background: #fee2e2; color: #ef4444; padding: 15px; border-radius: 10px; margin-bottom: 20px; border: 1px solid #fecaca; font-weight: bold;">
                    <%= error %>
                </div>
            <% } %>

            <form action="<%= truyen && truyen._id ? '/admin/edit/' + truyen._id : '/admin/add' %>" 
                  method="POST" 
                  enctype="multipart/form-data" 
                  class="card" 
                  style="max-width: 800px;">
                
                <label>Tên Truyện:</label>
                <input type="text" name="name" value="<%= truyen ? truyen.name : '' %>" required>
                
                <label>Thể loại / Danh mục:</label>
                <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-bottom: 15px;">
                    <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                        <% categories.forEach(cat => { 
                            let isChecked = false;
                            if (truyen && truyen.categories && truyen.categories.length > 0) {
                                isChecked = truyen.categories.some(c => c.toString() === cat._id.toString() || c._id.toString() === cat._id.toString());
                            }
                        %>
                            <label style="background: #f1f5f9; padding: 5px 10px; border-radius: 20px; cursor: pointer;">
                                <input type="checkbox" name="categories[]" value="<%= cat._id %>" <%= isChecked ? 'checked' : '' %>>
                                <%= cat.name %>
                            </label>
                        <% }) %>
                    <% } else { %>
                        <p>Chưa có danh mục nào. <a href="/admin/categories/add">Thêm ngay</a></p>
                    <% } %>
                </div>

                <label>Ảnh bìa (Nếu muốn thay đổi):</label>
                <input type="file" name="image" accept="image/*" style="padding: 10px; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 8px; margin-bottom: 15px; width: 100%; box-sizing: border-box;">
                
                <% if (truyen && truyen.image) { %>
                    <div style="margin-bottom: 20px;">
                        <p style="font-size: 0.9em; color: #64748b; margin-bottom: 5px;">Ảnh hiện tại:</p>
                        <img src="<%= truyen.image %>" height="150" style="border-radius: 8px; border: 1px solid #e2e8f0;">
                    </div>
                <% } %>

                <label>Từ viết tắt (Duy nhất):</label>
                <input type="text" name="shortCode" value="<%= truyen ? truyen.shortCode : '' %>" required placeholder="ví dụ: dptk" style="border: 2px solid #6366f1;">
                
                <label>Tổng số tập:</label>
                <input type="number" name="totalChapters" value="<%= truyen ? truyen.totalChapters : '' %>" required>
                
                <label>Giá tiền 1 tập (VNĐ):</label>
                <input type="number" name="price" value="<%= truyen ? truyen.price : '1000' %>" required style="font-weight: bold; color: #16a34a;">

                <label>Số tập mỗi gói (Chunk Size):</label>
                <input type="number" name="chunkSize" value="<%= truyen && truyen.chunkSize ? truyen.chunkSize : 10 %>" required min="1">
                <small style="color: #666; font-size: 0.85rem; display: block; margin-bottom: 10px;">* Nhập 10 -> Web chia: 1-10, 11-20...</small>

                <label>Số tập đã Public (Miễn phí):</label>
                <input type="number" name="publishedChapters" value="<%= truyen && truyen.publishedChapters ? truyen.publishedChapters : 0 %>" min="0" required>
                <small style="color: #666; font-size: 0.85rem; display: block; margin-bottom: 10px;">* Những tập này sẽ tự động được bỏ qua khi chia gói bán. Ví dụ: Đã up 2 tập thì gói đầu bán từ tập 3.</small>
                
                <!-- BẮT ĐẦU ĐOẠN ĐÃ ĐƯỢC SỬA LẠI THÀNH ĐÔI LINK -->
                <label>Link Google Drive:</label>
                <input type="text" name="link" value="<%= truyen ? truyen.link : '' %>" placeholder="https://drive.google.com/...">

                <label>Link YouTube:</label>
                <input type="text" name="linkYtb" value="<%= truyen ? truyen.linkYtb : '' %>" placeholder="https://youtube.com/...">
                <!-- KẾT THÚC ĐOẠN ĐÃ ĐƯỢC SỬA LẠI -->

                <label>Giới thiệu:</label>
                <textarea name="introduction" rows="5"><%= truyen ? truyen.introduction : '' %></textarea>
                
                <div style="display: flex; gap: 10px; margin-top: 20px;">
                    <button type="submit" class="btn-primary">Lưu lại</button>
                    <a href="/admin" class="btn-secondary">Hủy bỏ</a>
                </div>
            </form>
        </main>
    </div>
</body>
</html>