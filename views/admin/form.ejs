<!DOCTYPE html>
<html>
<head>
    <title><%= truyen && truyen._id ? 'Sửa Truyện' : 'Thêm Truyện' %></title>
    <link rel="stylesheet" href="/css/style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <div class="admin-wrapper">
        <%- include('../partials/admin-sidebar') %>

        <main class="admin-content">
            <div class="content-header">
                <h2><%= truyen && truyen._id ? 'Chỉnh Sửa Truyện' : 'Thêm Truyện Mới' %></h2>
            </div>

            <% if (error) { %>
                <div style="background: #fee2e2; color: #ef4444; padding: 15px; border-radius: 10px; margin-bottom: 20px; border: 1px solid #fecaca; font-weight: bold;">
                    <%= error %>
                </div>
            <% } %>

            <form action="<%= truyen && truyen._id ? '/admin/edit/' + truyen._id : '/admin/add' %>" method="POST" class="card" style="max-width: 800px;">
                
                <label>Tên Truyện:</label>
                <input type="text" name="name" value="<%= truyen ? truyen.name : '' %>" required>
                
                <label>Từ viết tắt (Duy nhất, ví dụ: dptk):</label>
                <input type="text" name="shortCode" value="<%= truyen ? truyen.shortCode : '' %>" required placeholder="Không được trùng..." style="border: 2px solid #6366f1;">
                
                <label>Tổng số tập (Số):</label>
                <input type="number" name="totalChapters" value="<%= truyen ? truyen.totalChapters : '' %>" required>
                
                <label>Giá tiền 1 tập (VNĐ):</label>
                <input type="number" name="price" value="<%= truyen ? truyen.price : '1000' %>" required placeholder="Ví dụ: 1000" style="font-weight: bold; color: #16a34a;">

                <label>Số tập mỗi gói (Chunk Size):</label>
                <input type="number" name="chunkSize" value="<%= truyen && truyen.chunkSize ? truyen.chunkSize : 10 %>" required min="1">
                <small style="color: #666; font-size: 0.85rem; display: block; margin-bottom: 10px;">
                    * Nhập 10 -> Web chia: 1-10, 11-20...
                </small>

                <label>Link Truyện (Gốc/Youtube):</label>
                <input type="text" name="link" value="<%= truyen ? truyen.link : '' %>" placeholder="https://...">

                <label>Giới thiệu:</label>
                <textarea name="introduction" rows="5"><%= truyen ? truyen.introduction : '' %></textarea>
                
                <div style="display: flex; gap: 10px; margin-top: 20px;">
                    <button type="submit" class="btn-primary">Lưu lại</button>
                    <a href="/admin" class="btn-secondary">Hủy bỏ</a>
                </div>
            </form>
        </main>
    </div>
</body>
</html>