<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cấu hình Thông Báo</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="admin-wrapper">
        <%- include('../partials/admin-sidebar') %>

        <main class="admin-content">
            <div class="content-header">
                <h2>📢 Cài đặt Thông Báo Web</h2>
            </div>

            <div class="card" style="max-width: 600px;">
                <form action="/admin/alert" method="POST">
                    <label><strong>Nội dung thông báo:</strong></label>
                    <textarea name="content" rows="4" placeholder="Ví dụ: Admin bận đi chơi..."><%= globalAlert.content %></textarea>
                    
                    <label><strong>Loại màu sắc:</strong></label>
                    <select name="type" style="width: 100%; padding: 10px; border: 1px solid #e2e8f0; border-radius: 10px; margin-bottom: 15px;">
                        <option value="warning" <%= globalAlert.type == 'warning' ? 'selected' : '' %>>Màu Vàng (Cảnh báo)</option>
                        <option value="danger" <%= globalAlert.type == 'danger' ? 'selected' : '' %>>Màu Đỏ (Quan trọng)</option>
                        <option value="info" <%= globalAlert.type == 'info' ? 'selected' : '' %>>Màu Xanh (Thông tin)</option>
                        <option value="success" <%= globalAlert.type == 'success' ? 'selected' : '' %>>Màu Xanh lá (Thành công)</option>
                    </select>

                    <div style="margin: 20px 0; display: flex; align-items: center; gap: 10px;">
                        <input type="checkbox" id="status" name="status" value="on" style="width: auto;" <%= globalAlert.isOn ? 'checked' : '' %>>
                        <label for="status"><strong>BẬT hiển thị trên web</strong></label>
                    </div>

                    <button type="submit" class="btn-primary">Lưu Cài Đặt</button>
                </form>
            </div>
        </main>
    </div>
</body>
</html>