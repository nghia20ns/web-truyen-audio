<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Ngân hàng thanh toán</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-wrapper { display: flex; min-height: 100vh; background: #f8fafc; }
        .admin-content { flex: 1; padding: 24px; max-width: 800px; }
        .bank-card {
            background: #fff; border: 2px solid #e2e8f0; border-radius: 12px;
            padding: 20px; margin-bottom: 16px; cursor: pointer;
            display: flex; align-items: center; justify-content: space-between;
            transition: all 0.2s;
        }
        .bank-card.selected { border-color: #4f46e5; background: #eef2ff; }
        .bank-info h3 { margin: 0 0 6px 0; color: #1e293b; font-size: 1.1rem; }
        .bank-info p { margin: 2px 0; color: #475569; font-size: 0.92rem; }
        .badge-active {
            background: #059669; color: #fff; padding: 4px 10px;
            border-radius: 20px; font-size: 0.78rem; font-weight: 600;
        }
        .btn-save {
            background: #4f46e5; color: #fff; border: none; padding: 12px 24px;
            border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 0.95rem;
        }
        .btn-save:hover { background: #4338ca; }
        .alert-success {
            background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0;
            padding: 12px 16px; border-radius: 8px; margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="admin-wrapper">
        <%- include('../partials/admin-sidebar') %>

        <div class="admin-content">
            <h2 style="margin-bottom: 8px;">🏦 Cấu hình Ngân hàng nhận thanh toán</h2>
            <p style="color: #64748b; margin-bottom: 20px;">Chọn ngân hàng hiển thị mã QR và thông tin chuyển khoản trên trang thanh toán của khách.</p>

            <% if (success) { %>
                <div class="alert-success">✅ Đã chuyển đổi ngân hàng thanh toán thành công!</div>
            <% } %>

            <form action="/admin/bank-config" method="POST">
                <% Object.values(banks).forEach(bank => { %>
                    <label class="bank-card <%= activeBank === bank.id ? 'selected' : '' %>" onclick="selectCard(this)">
                        <div style="display: flex; align-items: center; gap: 16px;">
                            <input type="radio" name="activeBank" value="<%= bank.id %>" <%= activeBank === bank.id ? 'checked' : '' %> style="width: 18px; height: 18px;">
                            <div class="bank-info">
                                <h3><%= bank.name %></h3>
                                <p>Số tài khoản: <strong><%= bank.accountNumber %></strong></p>
                                <p>Chủ tài khoản: <strong><%= bank.accountName %></strong></p>
                            </div>
                        </div>
                        <% if (activeBank === bank.id) { %>
                            <span class="badge-active">Đang sử dụng</span>
                        <% } %>
                    </label>
                <% }) %>

                <button type="submit" class="btn-save">Lưu thay đổi</button>
            </form>
        </div>
    </div>

    <script>
        function selectCard(el) {
            document.querySelectorAll('.bank-card').forEach(c => c.classList.remove('selected'));
            el.classList.add('selected');
        }
    </script>
</body>
</html>