                <a href="/chat/manager" style="display: flex; justify-content: space-between; align-items: center;">
                    <span>💬 Quản Lý Chat</span>
                    <span id="chat-badge" style="background: #ef4444; color: white; padding: 2px 8px; border-radius: 10px; font-size: 0.8rem; display: none; font-weight: bold;">0</span>
