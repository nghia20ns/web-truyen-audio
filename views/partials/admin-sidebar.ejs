            <li><a href="/admin/orders">🛒 Quản Lý Đơn Hàng</a></li>
            <li><a href="/admin/published-chapters" class="sidebar-item">📺 Quản lý Tập Public</a></li>
            
            <!-- ĐOẠN ĐƯỢC THÊM VÀO MENU CHÍNH -->
            <li><a href="/admin/quick-ytb" class="sidebar-item">🎵 Cập Nhật Nhanh YTB</a></li>
            
