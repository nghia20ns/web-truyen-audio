<div id="chat-box" class="chat-box">
    <div class="chat-header">
        <div style="display: flex; align-items: center; gap: 8px;">
            <span>💬 Hỗ trợ trực tuyến</span>
        </div>
        <div class="close-chat-btn" onclick="toggleChat()">✖</div>
    </div>
    
    <div id="chat-login" class="chat-body chat-login-screen">
        <h3 style="margin: 0 0 15px 0; color: #6366f1;">Xin chào!</h3>
        <input type="email" id="chat-email-input" placeholder="Nhập Gmail..." class="chat-input-styled">
        <button onclick="startChat()" class="btn-primary btn-start-chat">Bắt đầu Chat</button>
        <p id="chat-error" class="chat-error-msg"></p>
        <small style="color: #94a3b8; font-size: 0.8rem; margin-top: 15px;">*Tên hiển thị lấy theo Gmail.</small>
    </div>

    <div id="chat-interface" class="chat-body" style="display: none; padding: 0;">
