            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/9/91/Icon_of_Zalo.svg/1200px-Icon_of_Zalo.svg.png" width="30" height="30" style="border-radius: 5px;">
            <div>
                <strong>Chat qua Zalo</strong>
                <div style="font-size: 0.8rem; color: #666;">Phản hồi nhanh nhất</div>
            </div>
        </a>

        <a href="https://discord.gg/edkSbVmP4D" target="_blank" class="support-item">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="#0084FF"><path d="M12 2C6.48 2 2 6.03 2 11c0 2.87 1.56 5.47 3.97 7.08.23.15.38.41.36.68l-.13 2.19c-.04.66.71 1.09 1.25.71l2.36-1.63c.2-.14.45-.18.68-.12.82.21 1.69.32 2.58.32 5.52 0 10-4.03 10-9S18.52 2 12 2z"/></svg>
