<footer class="simple-footer">
    <div class="container footer-flex">
        <div class="copyright">
            &copy; <%= new Date().getFullYear() %> Web Truyện Audio.
        </div>
        <div class="footer-contact">
            <span>Liên hệ:</span>
            <a href="https://zalo.me/0336672088" target="_blank" class="contact-btn zalo">Zalo</a>
        </div>
    </div>
</footer>

<div id="chat-box" class="chat-box">
    <div class="chat-header">
        <div style="display: flex; align-items: center; gap: 10px;">
            <span>💬 Hỗ trợ trực tuyến</span>
        </div>
        <div class="close-chat-btn" onclick="toggleChat()">✖</div>
    </div>
    
    <div id="chat-login" class="chat-body chat-login-screen">
        <h3 style="margin: 0 0 15px 0; color: #6366f1;">Xin chào!</h3>
        <input type="email" id="chat-email-input" placeholder="Nhập Gmail..." class="chat-input-styled">
        <button onclick="startChat()" class="btn-primary btn-start-chat">Bắt đầu Chat</button>
        <p id="chat-error" class="chat-error-msg"></p>
        <small style="color: #999; font-size: 0.75rem; margin-top: 15px;">*Tên hiển thị lấy theo Gmail.</small>
    </div>

    <div id="chat-interface" class="chat-body" style="display: none; padding: 0;">
        <div id="messages-list" class="messages-list"></div>
        
        <div id="offline-alert" class="offline-screen" style="display: none;">
            <div class="offline-icon">😴</div>
            <h3>Admin Offline</h3>
            <p>Vui lòng liên hệ Zalo để được hỗ trợ.</p>
            <a href="https://zalo.me/0336672088" target="_blank" class="contact-btn zalo large">Chat Zalo</a>
        </div>

        <div id="input-area-wrapper" class="chat-input-area">
            <input type="text" id="msg-input" placeholder="Nhập tin nhắn..." onkeypress="handleEnter(event)">
            <button onclick="sendUserMessage()" class="btn-send-msg">➤</button>
        </div>
    </div>
</div>

<div id="chat-trigger" class="floating-chat-btn" onclick="toggleChat()">
    <svg viewBox="0 0 24 24" width="30" height="30" fill="white"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/></svg>
</div>

<style>
    :root { --primary: #6366f1; }
    .simple-footer { background-color: white; border-top: 1px solid #f1f5f9; padding: 25px 0; margin-top: 60px; font-size: 0.95rem; color: #64748b; }
    .footer-flex { display: flex; justify-content: space-between; align-items: center; }
    .contact-btn { display: inline-flex; align-items: center; gap: 5px; text-decoration: none; padding: 6px 14px; border-radius: 30px; font-weight: 600; font-size: 0.85rem; color: white !important; }
    .contact-btn.zalo { background: #0068FF; }
    
    /* Nút chat tròn */
    .floating-chat-btn { 
        position: fixed; bottom: 30px; right: 30px; width: 60px; height: 60px; 
        background: linear-gradient(135deg, #6366f1, #8b5cf6); border-radius: 50%; 
        display: flex; justify-content: center; align-items: center; cursor: pointer; 
        z-index: 10001; box-shadow: 0 5px 15px rgba(99, 102, 241, 0.4); 
        transition: all 0.3s ease; /* Hiệu ứng mượt */
    }
    
    /* Class ẩn nút chat (Thêm cái này theo yêu cầu của bạn) */
    .floating-chat-btn.hidden {
        opacity: 0;
        transform: scale(0);
        pointer-events: none;
    }
    
    .chat-box { position: fixed; bottom: 100px; right: 30px; width: 340px; height: 480px; background: white; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); z-index: 10000; display: flex; flex-direction: column; opacity: 0; pointer-events: none; transition: 0.3s; transform: translateY(20px); }
    .chat-box.active { opacity: 1; pointer-events: all; transform: translateY(0); }
    
    .chat-header { background: linear-gradient(to right, #6366f1, #8b5cf6); color: white; padding: 12px 15px; font-weight: bold; display: flex; justify-content: space-between; align-items: center; }
    .close-chat-btn { cursor: pointer; font-size: 1.2rem; }
    
    .chat-body { flex: 1; display: flex; flex-direction: column; overflow: hidden; background: #f8fafc; }
    .chat-login-screen { justify-content: center; align-items: center; padding: 20px; text-align: center; }
    .chat-input-styled { width: 100%; padding: 10px; margin-bottom: 10px; border-radius: 8px; border: 1px solid #ddd; box-sizing: border-box; }
    .btn-start-chat { width: 100%; padding: 10px; background: #6366f1; color: white; border: none; border-radius: 8px; cursor: pointer; }
    
    .messages-list { flex: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 8px; }
    .msg { padding: 8px 12px; border-radius: 12px; max-width: 80%; word-wrap: break-word; font-size: 0.9rem; }
    .msg.me { align-self: flex-end; background: #6366f1; color: white; }
    .msg.admin { align-self: flex-start; background: white; border: 1px solid #eee; }
    
    .chat-input-area { display: flex; padding: 10px; background: white; border-top: 1px solid #eee; }
    .chat-input-area input { flex: 1; border: none; outline: none; background: #f1f5f9; padding: 8px 12px; border-radius: 20px; }
    .btn-send-msg { border: none; background: #6366f1; color: white; width: 35px; height: 35px; border-radius: 50%; margin-left: 8px; cursor: pointer; }
    
    .offline-screen { flex: 1; flex-direction: column; justify-content: center; align-items: center; padding: 20px; text-align: center; background: #fff1f2; }
    .offline-icon { font-size: 3rem; margin-bottom: 10px; }
    
    @media (max-width: 480px) {
        .chat-box { width: 100%; height: 100%; bottom: 0; right: 0; border-radius: 0; }
        .chat-box.active { display: flex; }
    }
</style>

<script>
    let chatInterval = null;
    let sessionId = localStorage.getItem('chat_session_id');
    let userName = localStorage.getItem('chat_user_name');
    let isAdminOnline = true;
    let lastMsgCount = 0; // Vẫn cần biến này để check có tin mới không để render
    
    if (!sessionId) {
        sessionId = 'sess_' + Math.random().toString(36).substr(2, 9);
        localStorage.setItem('chat_session_id', sessionId);
    }

    async function toggleChat() {
        const box = document.getElementById('chat-box');
        const triggerBtn = document.getElementById('chat-trigger'); // Lấy nút tròn

        box.classList.toggle('active');
        
        if (box.classList.contains('active')) {
            // Mở chat -> Ẩn nút tròn
            triggerBtn.classList.add('hidden');

            const res = await fetch('/chat/status');
            const data = await res.json();
            isAdminOnline = data.isOnline;
            checkLoginStatus();
        } else {
            // Đóng chat -> Hiện lại nút tròn
            triggerBtn.classList.remove('hidden');

            if (chatInterval) clearInterval(chatInterval);
        }
    }

    function checkLoginStatus() {
        if (userName) {
            document.getElementById('chat-login').style.display = 'none';
            document.getElementById('chat-interface').style.display = 'flex';
            if (!isAdminOnline) {
                document.getElementById('offline-alert').style.display = 'flex';
                document.getElementById('input-area-wrapper').style.display = 'none';
                document.getElementById('messages-list').style.display = 'none';
            } else {
                document.getElementById('offline-alert').style.display = 'none';
                document.getElementById('input-area-wrapper').style.display = 'flex';
                document.getElementById('messages-list').style.display = 'flex';
                loadMessages();
                chatInterval = setInterval(loadMessages, 3000);
            }
        } else {
            document.getElementById('chat-login').style.display = 'flex';
            document.getElementById('chat-interface').style.display = 'none';
        }
    }

    function startChat() {
        const input = document.getElementById('chat-email-input');
        const email = input.value.trim();
        if(email.includes('@gmail.com')){
            userName = email.split('@')[0];
            localStorage.setItem('chat_user_name', userName);
            checkLoginStatus();
        } else {
            document.getElementById('chat-error').innerText = "Vui lòng nhập đúng Gmail!";
            document.getElementById('chat-error').style.display = 'block';
        }
    }

    async function sendUserMessage() {
        const input = document.getElementById('msg-input');
        const text = input.value.trim();
        if (!text) return;
        
        appendMessage(text, 'me');
        input.value = '';
        scrollToBottom();
        
        await fetch('/chat/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sessionId, userName, sender: 'client', content: text })
        });
    }

    function handleEnter(e) { if (e.key === 'Enter') sendUserMessage(); }

    async function loadMessages() {
        try {
            const res = await fetch(`/chat/history?sessionId=${sessionId}`);
            const msgs = await res.json();
            
            // Chỉ render lại nếu số lượng tin nhắn thay đổi
            // KHÔNG CÒN LOGIC THÔNG BÁO Ở ĐÂY NỮA
            if (msgs.length > lastMsgCount) {
                const list = document.getElementById('messages-list');
                list.innerHTML = ''; 
                msgs.forEach(m => {
                    const type = m.sender === 'client' ? 'me' : 'admin';
                    appendMessage(m.content, type);
                });
                
                scrollToBottom();
                lastMsgCount = msgs.length;
            }
        } catch (e) {}
    }

    function appendMessage(content, type) {
        const div = document.createElement('div');
        div.className = `msg ${type}`;
        div.innerHTML = type === 'admin' ? `<strong>Admin:</strong> ${content}` : content;
        document.getElementById('messages-list').appendChild(div);
    }
    
    function scrollToBottom() {
        const list = document.getElementById('messages-list');
        list.scrollTop = list.scrollHeight;
    }
    
    if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', () => {
             const box = document.getElementById('chat-box');
             if(box.classList.contains('active') && window.innerWidth <= 480) {
                 box.style.height = window.visualViewport.height + 'px';
                 scrollToBottom();
             }
        });
    }
</script>