<div id="chat-trigger" class="floating-chat-btn" onclick="toggleChat()">
    <svg viewBox="0 0 24 24" width="30" height="30" fill="white"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/></svg>
</div>

<style>
    :root {
        --primary: #6366f1;
        --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    .simple-footer, .chat-box, .floating-chat-btn {
        font-family: var(--font-stack);
        -webkit-font-smoothing: antialiased;
    }

    .simple-footer { background-color: white; border-top: 1px solid #f1f5f9; padding: 25px 0; margin-top: 60px; font-size: 0.95rem; color: #64748b; }
    .footer-flex { display: flex; justify-content: space-between; align-items: center; }
    .footer-contact { display: flex; align-items: center; gap: 10px; }

    .contact-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        padding: 7px 16px;
        border-radius: 9999px;
        font-weight: 600;
        font-size: 0.875rem;
        line-height: 1;
        color: #ffffff !important;
        transition: transform 0.15s ease, filter 0.15s ease;
    }

    .contact-btn:hover {
        filter: brightness(1.08);
        transform: translateY(-1px);
    }

    .contact-btn.large {
        padding: 10px 20px;
        font-size: 0.95rem;
        width: 100%;
        max-width: 220px;
        box-sizing: border-box;
    }

    .contact-btn.zalo { background: #0068FF; }
    .contact-btn.discord { background: #5865F2; }

    .floating-chat-btn { 
        position: fixed; bottom: 30px; right: 30px; width: 60px; height: 60px; 
        background: linear-gradient(135deg, #6366f1, #8b5cf6); border-radius: 50%; 
        display: flex; justify-content: center; align-items: center; cursor: pointer; 
        z-index: 10001; box-shadow: 0 5px 15px rgba(99, 102, 241, 0.4); 
        transition: all 0.3s ease;
    }
    
    .floating-chat-btn.hidden {
        opacity: 0;
        transform: scale(0);
        pointer-events: none;
    }
    
    .chat-box { 
        position: fixed; bottom: 100px; right: 30px;
        width: 340px; height: 480px; background: white; border-radius: 12px; 
        box-shadow: 0 10px 30px rgba(0,0,0,0.15); z-index: 10000; 
        display: flex; flex-direction: column;
        opacity: 0; pointer-events: none; 
        transition: opacity 0.3s, transform 0.3s; 
        transform: translateY(20px); 
    }
    .chat-box.active { opacity: 1; pointer-events: all; transform: translateY(0); }
    
    .chat-header { background: linear-gradient(to right, #6366f1, #8b5cf6); color: white; padding: 12px 15px; font-weight: 600; display: flex; justify-content: space-between; align-items: center; font-size: 0.95rem; }
    .close-chat-btn { cursor: pointer; font-size: 1.1rem; opacity: 0.9; }
    .close-chat-btn:hover { opacity: 1; }
    
    .chat-body { flex: 1; display: flex; flex-direction: column; overflow: hidden; background: #f8fafc; }
    .chat-login-screen { justify-content: center; align-items: center; padding: 24px; text-align: center; }
    .chat-input-styled { width: 100%; padding: 10px 12px; margin-bottom: 10px; border-radius: 8px; border: 1px solid #cbd5e1; box-sizing: border-box; font-family: inherit; font-size: 0.9rem; }
    .chat-input-styled:focus { outline: none; border-color: #6366f1; }
    .btn-start-chat { width: 100%; padding: 10px; background: #6366f1; color: white; border: none; border-radius: 8px; font-weight: 600; font-family: inherit; cursor: pointer; }
    .chat-error-msg { color: #ef4444; font-size: 0.8rem; margin-top: 5px; display: none; }

    .messages-list { flex: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 8px; }
    .msg { padding: 9px 13px; border-radius: 12px; max-width: 80%; word-wrap: break-word; font-size: 0.9rem; line-height: 1.4; }
    .msg.me { align-self: flex-end; background: #6366f1; color: white; }
    .msg.admin { align-self: flex-start; background: white; border: 1px solid #e2e8f0; color: #1e293b; }
    
    .chat-input-area { display: flex; padding: 10px; background: white; border-top: 1px solid #f1f5f9; }
    .chat-input-area input { flex: 1; border: none; outline: none; background: #f1f5f9; padding: 8px 14px; border-radius: 20px; font-family: inherit; font-size: 0.9rem; }
    .btn-send-msg { border: none; background: #6366f1; color: white; width: 36px; height: 36px; border-radius: 50%; margin-left: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    
    .offline-screen { flex: 1; flex-direction: column; justify-content: center; align-items: center; padding: 24px; text-align: center; background: #fafafa; }
    .offline-screen h3 { font-size: 1rem; color: #334155; margin: 0 0 16px 0; font-weight: 600; line-height: 1.4; }
    .offline-icon { font-size: 2.5rem; margin-bottom: 8px; }
    .offline-btns { display: flex; flex-direction: column; gap: 10px; width: 100%; align-items: center; }
    
    @media (max-width: 480px) {
        .chat-box { width: 100%; height: 100%; bottom: 0; right: 0; border-radius: 0; }
        .chat-box.active { display: flex; }
    }
</style>

<script>
    let chatInterval = null;
    let sessionId = localStorage.getItem('chat_session_id');
    let userName = localStorage.getItem('chat_user_name');
    let isAdminOnline = true;
    let lastMsgCount = 0;
    
    if (!sessionId) {
        sessionId = 'sess_' + Math.random().toString(36).substr(2, 9);
        localStorage.setItem('chat_session_id', sessionId);
    }

    async function toggleChat() {
        const box = document.getElementById('chat-box');
        const triggerBtn = document.getElementById('chat-trigger');

        box.classList.toggle('active');
        
        if (box.classList.contains('active')) {
            triggerBtn.classList.add('hidden');

            const res = await fetch('/chat/status');
            const data = await res.json();
            isAdminOnline = data.isOnline;
            checkLoginStatus();
        } else {
            triggerBtn.classList.remove('hidden');
            if (chatInterval) clearInterval(chatInterval);
        }
    }

    function checkLoginStatus() {
        if (userName) {
            document.getElementById('chat-login').style.display = 'none';
            document.getElementById('chat-interface').style.display = 'flex';
            if (!isAdminOnline) {
                document.getElementById('offline-alert').style.display = 'flex';
                document.getElementById('input-area-wrapper').style.display = 'none';
                document.getElementById('messages-list').style.display = 'none';
            } else {
                document.getElementById('offline-alert').style.display = 'none';
                document.getElementById('input-area-wrapper').style.display = 'flex';
                document.getElementById('messages-list').style.display = 'flex';
                loadMessages();
                chatInterval = setInterval(loadMessages, 3000);
            }
        } else {
            document.getElementById('chat-login').style.display = 'flex';
            document.getElementById('chat-interface').style.display = 'none';
        }
    }

    function startChat() {
        const input = document.getElementById('chat-email-input');
        const email = input.value.trim();
        if(email.includes('@gmail.com')){
            userName = email.split('@')[0];
            localStorage.setItem('chat_user_name', userName);
            checkLoginStatus();
        } else {
            document.getElementById('chat-error').innerText = "Vui lòng nhập đúng Gmail!";
            document.getElementById('chat-error').style.display = 'block';
        }
    }

    async function sendUserMessage() {
        const input = document.getElementById('msg-input');
        const text = input.value.trim();
        if (!text) return;
        
        appendMessage(text, 'me');
        input.value = '';
        scrollToBottom();
        
        await fetch('/chat/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sessionId, userName, sender: 'client', content: text })
        });
    }

    function handleEnter(e) { if (e.key === 'Enter') sendUserMessage(); }

    async function loadMessages() {
        try {
            const res = await fetch(`/chat/history?sessionId=${sessionId}`);
            const msgs = await res.json();
            
            if (msgs.length > lastMsgCount) {
                const list = document.getElementById('messages-list');
                list.innerHTML = ''; 
                msgs.forEach(m => {
                    const type = m.sender === 'client' ? 'me' : 'admin';
                    appendMessage(m.content, type);
                });
                
                scrollToBottom();
                lastMsgCount = msgs.length;
            }
        } catch (e) {}
    }

    function appendMessage(content, type) {
        const div = document.createElement('div');
        div.className = `msg ${type}`;
        div.innerHTML = type === 'admin' ? `<strong>Admin:</strong> ${content}` : content;
        document.getElementById('messages-list').appendChild(div);
    }
    
    function scrollToBottom() {
        const list = document.getElementById('messages-list');
        list.scrollTop = list.scrollHeight;
    }
    
    if (window.visualViewport) {
        const handleResize = () => {
             const box = document.getElementById('chat-box');
             if(box.classList.contains('active') && window.innerWidth <= 480) {
                 requestAnimationFrame(() => {
                     box.style.height = window.visualViewport.height + 'px';
                     box.style.bottom = '0px'; 
                     scrollToBottom();
                 });
             }
        };

        window.visualViewport.addEventListener('resize', handleResize);
        window.visualViewport.addEventListener('scroll', handleResize);
    }
</script>