<div id="chat-trigger" class="floating-chat" title="Hỗ trợ">
    <svg id="icon-chat" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/></svg>
    <svg id="icon-close" viewBox="0 0 24 24" style="display: none;"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
</div>

<script>
    const trigger = document.getElementById('chat-trigger');
    const menu = document.getElementById('support-menu');
    const iconChat = document.getElementById('icon-chat');
    const iconClose = document.getElementById('icon-close');

    trigger.addEventListener('click', function() {
        // Toggle ẩn hiện menu
        if (menu.style.display === 'block') {
            menu.style.display = 'none';
            iconChat.style.display = 'block';
            iconClose.style.display = 'none';
        } else {
            menu.style.display = 'block';
            iconChat.style.display = 'none';
            iconClose.style.display = 'block';
        }
    });
</script>